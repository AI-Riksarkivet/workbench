# The workbench's OpenFGA in development: the workbench's own authorization store, a server of its own on a Postgres of
# its own, beside the workbench's release. NOT FOR PRODUCTION: a platform runs OpenFGA and the workbench names it
# (`auth.fga.apiUrl`, `auth.fga.credential`). A development estate's other OpenFGA (rask's) admits only its own
# ServiceAccounts, so the workbench brings its own.
RELEASE=workbench-openfga
NAMESPACE=workbench
CHART=chart
