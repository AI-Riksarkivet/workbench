# The workbench's release (services/viewer, services/search, services/annotator and the app; the `media`, `annotator`
# and `frontend` images): it works on the lakehouse as any client does. Its services read governed tables through the
# catalog's doors as the person, on a token the deployment's provider allows (exchanged for them, or their own passed
# on), and the annotator writes annotations and publishes as the workbench's own confidential client. Its projects and
# tasks live in its own Postgres, which this release renders; who may do what is the workbench's own OpenFGA store,
# whose model and declared organisations this release's model writer converges before the pod rolls. rask's product
# chart renders none of it; this release reaches a rask release by reference only: the catalog's address.
RELEASE=workbench
# A namespace of its own: the state database's NetworkPolicy is all that admits its pods only where no other policy of
# the namespace admits them, and rask's `allow-ingress-intra-namespace` admits every pod of the namespace it is in.
NAMESPACE=workbench
SHARED_NAMESPACE=false
CHART=chart
WAIT=false
