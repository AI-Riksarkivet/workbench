# The annotator (services/annotator, the `annotator` image): a labeling tool that works on the lakehouse as any client
# does. It reads governed tables through the catalog's doors as the person, on a token it exchanges for them at the
# identity provider, and writes annotations and publishes as the workbench's own confidential client. Its projects and
# tasks live in its own Dapr state store on a Postgres this release renders; who may do what is the workbench's own
# OpenFGA store, whose model and declared organisations this release's model writer converges before the pod rolls.
# The product chart renders none of it; this release runs beside a rask release and reaches it by reference only: the
# catalog's address. The identity provider and OpenFGA are the platform's, named in its values.
RELEASE=annotator
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
