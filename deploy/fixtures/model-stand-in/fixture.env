# A stand-in model endpoint in development: it speaks the workbench's model protocol and holds no model, so assist can be
# walked on a cluster that runs none (ADR 0023). NOT FOR PRODUCTION: a deployment names its real model endpoint
# (`models.endpoint.url`), and the workbench deploys no model.
RELEASE=workbench-model-stand-in
NAMESPACE=workbench
CHART=chart
