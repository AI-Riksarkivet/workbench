{
	"name": "explorer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173 --host 127.0.0.1",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tsgo": "tsgo --noEmit -p tsconfig.tsgo.json",
		"lint": "oxlint .",
		"fmt": "rsvelte-fmt .",
		"fmt:check": "rsvelte-fmt --check ."
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"@workbench/api": "workspace:*",
		"@workbench/explorer-api": "workspace:*",
		"@workbench/flow": "workspace:*",
		"@workbench/labeling": "workspace:*",
		"@workbench/ui": "workspace:*",
		"@xyflow/svelte": "^1.6.2",
		"@xyflow/system": "^0.0.79",
		"bits-ui": "^2.18.1",
		"elkjs": "^0.12.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.8",
		"svelte-sonner": "^1.1.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@webgpu/types": "^0.1.71",
		"@workbench/config": "workspace:*",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
