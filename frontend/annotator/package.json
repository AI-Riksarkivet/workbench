{
	"name": "annotator",
	"version": "0.0.1",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "oxlint .",
		"fmt": "rsvelte-fmt .",
		"fmt:check": "rsvelte-fmt --check .",
		"test:e2e:live": "node e2e/annotator.e2e.mjs && node e2e/temporal.e2e.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"@riksarkivet/ui": "github:AI-Riksarkivet/ui#81d50a0df4eb68a104cad6646a7ac6856b4702ac",
		"@workbench/api": "workspace:*",
		"@workbench/engine": "workspace:*",
		"@workbench/explorer-api": "workspace:*",
		"@workbench/labeling": "workspace:*",
		"apache-arrow": "^21.2.0",
		"bits-ui": "^2.18.1",
		"gsap": "^3.15.0",
		"mode-watcher": "^1.1.0",
		"pixi.js": "^8.19.0",
		"svelte": "^5.56.8",
		"svelte-sonner": "^1.1.1",
		"valibot": "^1.4.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@webgpu/types": "^0.1.71",
		"@workbench/config": "workspace:*",
		"playwright-core": "^1.62.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.10"
	}
}
