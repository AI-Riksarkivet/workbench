model
  schema 1.1

# The workbench's own authorization model: who may do what to its organisations, projects, tasks, corpora and flows.
# It names nothing of a lakehouse's: whether a person may read or write a table there is the lakehouse's to decide,
# on the person's own credential.

type user

# An organisation: the tenant a project belongs to. Its admins own every project below it; its members view them and
# may start new ones. Who administers and who belongs is declared in git and converged by the model writer.
type org
  relations
    define admin: [user]
    define member: [user] or admin

    define can_administer: admin
    define can_create_project: member
    define can_list_projects: member

# A project's five roles, concentric: owner > manager > reviewer > annotator > viewer. An org admin owns every project
# of the org and an org member views it.
type project
  relations
    define org: [org]

    define owner: [user] or admin from org
    define manager: [user] or owner
    define reviewer: [user] or manager
    define annotator: [user] or reviewer
    define viewer: [user] or annotator or member from org

    # The owner alone grants or revokes the owner and manager roles and deletes the project, so a manager can neither
    # make themselves owner nor remove the owner.
    define can_administer: owner
    define can_delete: can_administer
    define can_manage: manager
    define can_publish: can_manage
    define can_review: reviewer
    define can_annotate: annotator
    define can_claim: can_annotate
    define can_send_items: can_annotate
    define can_view: viewer

    # Create on the parent: a task is made by sending items, and the same act binds the corpus they come from, which
    # grants nothing beyond viewing it: a project's annotations are its own rows, checked on the project.
    define can_create_task: can_send_items
    define can_bind_corpus: can_send_items

    # Flows: owner and manager create, edit and run; reviewer and annotator run; viewer reads the flow and its runs.
    define can_create_flow: can_manage
    define can_edit_flow: can_manage
    define can_run_flow: can_annotate
    define can_read_flow: can_view

# A task inherits every permission from its project.
type task
  relations
    define project: [project]

    define can_view: can_view from project
    define can_claim: can_claim from project
    define can_annotate: can_annotate from project
    define can_review: can_review from project
    define can_manage: can_manage from project

# A corpus is a dataset bound to each project that sends items from it. The binding lets the project's people see that
# the project uses it, and nothing more: annotating is a project's, on the project's own rows.
type corpus
  relations
    define project: [project]

    define can_view: can_view from project

# A source no catalog decides reads for per person (a lance-namespace catalog, a bare table, a lakehouse read as the
# workbench): its readers are what git declares for it, an organisation's members or a person, written by the model
# writer. A source that names none is read by nobody.
type source
  relations
    define reader: [user, org#member]

    define can_read: reader

# A flow belongs to one project and takes its permissions from it.
type flow
  relations
    define project: [project]

    define can_read: can_read_flow from project
    define can_edit: can_edit_flow from project
    define can_run: can_run_flow from project
